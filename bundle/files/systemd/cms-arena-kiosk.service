[Unit]
Description=CMS arena display kiosk (cage + Chromium on tty1)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# CMS_DISPLAY_URL, written by cms-arena-kiosk-cert (read by systemd as root)
EnvironmentFile=-/etc/cms-arena-agent/kiosk.env
# -d: no client-side decorations. No -s: switching to another console is disabled.
ExecStart=/usr/bin/cage -d -- /usr/local/bin/cms-arena-kiosk-browser
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
